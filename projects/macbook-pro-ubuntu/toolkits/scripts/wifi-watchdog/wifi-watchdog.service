[Unit]
Description=Detect and recover stalled Wi-Fi
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
ExecStart=/usr/local/bin/wifi-watchdog
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
